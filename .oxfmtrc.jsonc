{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": false,
    "semi": false,
    "trailingComma": "all",
    "printWidth": 100,
    "endOfLine": "lf",
    "proseWrap": "preserve",
    "sortPackageJson": {
        "sortScripts": false,
    },
    "overrides": [
        {
            "files": ["*.yml", "*.yaml", "**/*.yml", "**/*.yaml"],
            "options": {
                "tabWidth": 2,
            },
        },
    ],
    "ignorePatterns": [".agents/**", "coverage/**", "dist/**", "fixture/**", "skills-lock.json"],
}
